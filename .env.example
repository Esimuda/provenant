# Copy to .env and fill in. Never commit .env.

# EVM deployer for pallet-revive. Hex private key, with or without 0x.
# Fund the mapped native account (npm run native -- map), not the 0x address directly.
PRIVATE_KEY=

# Native signer for NFTs, identity, manifests, vesting, and the relayer.
# sr25519 secret URI. Read from the environment only — never pass it as a CLI argument.
SURI=

# Endpoints. Defaults are the V3 testnet.
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_SUBSTRATE_RPC=wss://test-node-v3.portaldot.dev

# Set after deploy. The web app reads the NEXT_PUBLIC_ pair.
PROVENANT_ADDRESS=
NEXT_PUBLIC_PROVENANT_ADDRESS=
NEXT_PUBLIC_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev

# Native collection created by `provenant-native mint`. Omit on the first mint.
COLLECTION_ID=

# Relayer. Bind stays on loopback unless you set RELAYER_HOST knowingly.
RELAYER_URL=http://127.0.0.1:8787
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8787
# Optional shared secret the Next server sends. Leave empty for local demo.
RELAYER_TOKEN=
# Scan start. "latest" or a decimal block. Save this; receipts are pruned.
RELAYER_FROM_BLOCK=latest
# Long royalty. Live minimum is 10 tPOT = 1e15 planck. 10000 blocks divides it.
VESTING_LOCKED=1000000000000000
VESTING_BLOCKS=10000
